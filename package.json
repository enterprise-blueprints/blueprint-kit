{
  "name": "blueprint-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "editor": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/editor.ts",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "kit:init": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/init.ts",
    "kit:save-solution": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/save-solution.ts",
    "sync": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync.ts",
    "content:build": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/content.ts build",
    "content:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/content.ts check",
    "content:publish": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/content.ts publish",
    "verify": "pnpm content:check && pnpm check && pnpm test && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "6.4.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22",
    "typescript": "^6",
    "vitest": "^5.0.5"
  }
}
