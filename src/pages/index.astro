---
// Your home page: what you offer, your missions and the library's your
// packages build on, and your packages. Everything else is the library's pages.
import Base from '../layouts/Base.astro';
import TypeBadge from '../components/TypeBadge.astro';
import LibraryMark from '../components/LibraryMark.astro';
import ResourceCard from '../kit/ResourceCard.astro';
import { downloadUrl, elementsOfType, helpsWith, isOwn, missionBlueprint, ownPackages, release, scopeLabel, tagline, upstream, type LibraryElement } from '../lib/library';
import { plural } from '../lib/format';
import { href } from '../lib/paths';
import { resourceKinds } from '../lib/vocabulary';
import { site } from '../site';

// Your resources, kind by kind, in the library's order of kinds.
const kinds = Object.keys(resourceKinds.groups);
const offered = elementsOfType('resource')
  .filter((r) => isOwn(r.package))
  .sort((a, b) => kinds.indexOf(String(a.attributes?.kind)) - kinds.indexOf(String(b.attributes?.kind)));

// Each mission with what's under it, and how many of your resources help with any of it.
const missions = elementsOfType('mission').map((m) => {
  const b = missionBlueprint(m);
  const within = new Set<LibraryElement>([m, ...b.outcomes.map((o) => o.outcome), ...b.capabilities.map((c) => c.capability), ...b.requirements, ...b.patterns]);
  const helping = offered.filter((r) => helpsWith(r).some((h) => within.has(h.element))).length;
  return { m, outcomes: b.outcomes.length, capabilities: b.capabilities.length, patterns: b.patterns.length, helping };
});
const own = missions.filter((x) => isOwn(x.m.package));
const library = missions.filter((x) => !isOwn(x.m.package)).sort((a, b) => b.helping - a.helping || a.m.title.localeCompare(b.m.title));
const catalog = new URL(href('catalog.json'), Astro.site).href;
---
<Base>
  <div class="container">
    <header class="page-header">
      <h1>{site.title}</h1>
      <p class="lede">{site.description}</p>
      <p class="muted">
        Release {release}, built on{' '}
        <a href={upstream!.url} target="_blank" rel="noopener">{upstream!.title}<span class="sr-only"> (opens in a new tab)</span></a> {upstream!.release}.
      </p>
    </header>
    <aside class="notice built-on" aria-label={`Built on ${upstream!.title}`}>
      <p>
        <strong>{upstream!.title} is the shared knowledge underneath.</strong> It's an open library of what
        public organizations are responsible for and the capabilities that work depends on, with example
        patterns and its sources. This site adds our work to it, in its terms: what we offer, linked to the
        missions, capabilities, and patterns it helps with.{library.length > 0 && <> Items from the library carry a small book
        (<LibraryMark element={library[0].m} legend />).</>} <a href={href('about/')}>More about this site</a>
      </p>
    </aside>
  </div>

  {offered.length > 0 && (
    <section class="section-band" aria-labelledby="offer-heading">
      <div class="container">
        <div class="section-intro">
          <h2 id="offer-heading">What we offer</h2>
          <p>Each one names the missions, capabilities, and patterns it helps with, so you can find it where it fits.</p>
        </div>
        <ul class="offer-grid">{offered.map((r) => <ResourceCard resource={r} />)}</ul>
      </div>
    </section>
  )}

  {missions.length > 0 && (
    <section class="section-band section-band--muted" aria-labelledby="missions-heading">
      <div class="container">
        <div class="section-intro">
          <h2 id="missions-heading">Missions</h2>
          <p>
            {own.length > 0 ? 'Missions of our own, and the missions' : 'The missions'} from {upstream!.title} that our work builds on,
            with what we offer shown where it helps.
          </p>
          {library.length > 0 && <p class="muted"><LibraryMark element={library[0].m} legend /> marks the ones from {upstream!.title}.</p>}
        </div>
        <div class="mission-grid">
          {[...own, ...library].map(({ m, outcomes, capabilities, patterns, helping }) => (
            <article class={`card type-${m.type}`}>
              <div class="card__meta">
                <TypeBadge type={m.type} />
                {scopeLabel(m.package) && <span class="scope-badge">{scopeLabel(m.package)}</span>}
                {isOwn(m.package) && <span class="scope-badge">Ours</span>}
              </div>
              <h3 class="card__title"><a href={m.url}>{m.title}</a><LibraryMark element={m} /></h3>
              {tagline(m) && <p class="card__tagline">{tagline(m)}</p>}
              <p class="card__summary">{m.description}</p>
              <ul class="card__facts">
                {outcomes > 0 && <li><strong>{outcomes}</strong> {outcomes === 1 ? 'outcome' : 'outcomes'}</li>}
                <li><strong>{capabilities}</strong> {capabilities === 1 ? 'capability' : 'capabilities'}</li>
                {patterns > 0 && <li><strong>{patterns}</strong> candidate {patterns === 1 ? 'pattern' : 'patterns'}</li>}
                {helping > 0 && <li><strong>{helping}</strong> of what we offer</li>}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-band" aria-labelledby="packages-heading">
    <div class="container">
      <div class="section-intro">
        <h2 id="packages-heading">Packages</h2>
        <p>Tools such as Solution Studio read these from the catalog at <code>{catalog}</code>, beside the library’s.</p>
      </div>
      <div class="table-wrap">
        <table class="stack-table">
          <thead><tr><th scope="col">Package</th><th scope="col">Version</th><th scope="col">Holds</th><th scope="col">Download</th></tr></thead>
          <tbody>
            {ownPackages.map((p) => (
              <tr>
                <th scope="row">{p.title}<p class="muted">{p.description}</p></th>
                <td>{p.version}</td>
                <td>{plural(p.elements.length, 'item', 'items')}</td>
                <td><a href={downloadUrl(p)}>JSON</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .built-on { max-width: 60rem; margin: 0 0 2rem; }
  .built-on p { margin: 0; }
  .offer-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .stack-table th[scope='row'] { font-weight: 650; }
  .stack-table th[scope='row'] p { margin: .25rem 0 0; font-weight: 400; }
</style>
